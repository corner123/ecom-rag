{
  "$defs": {
    "BusinessDecision": {
      "additionalProperties": false,
      "description": "A separate decision label used by business evaluation metrics.",
      "properties": {
        "business_decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Business Decision Id",
          "type": "string"
        },
        "decision_text": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Text",
          "type": "string"
        },
        "decision_type": {
          "default": "recommend",
          "enum": [
            "recommend",
            "escalate",
            "refuse"
          ],
          "title": "Decision Type",
          "type": "string"
        },
        "key_claim_ids": {
          "items": {
            "maxLength": 70,
            "minLength": 70,
            "pattern": "^claim_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Key Claim Ids",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "business_decision_id",
        "key_claim_ids",
        "decision_text"
      ],
      "title": "BusinessDecision",
      "type": "object"
    },
    "BusinessDecisionRecord": {
      "additionalProperties": false,
      "description": "The strict JSONL envelope for a business-decision artifact.",
      "properties": {
        "artifact_type": {
          "const": "business_decision",
          "default": "business_decision",
          "title": "Artifact Type",
          "type": "string"
        },
        "business_decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Business Decision Id",
          "type": "string"
        },
        "decision_text": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Text",
          "type": "string"
        },
        "decision_type": {
          "default": "recommend",
          "enum": [
            "recommend",
            "escalate",
            "refuse"
          ],
          "title": "Decision Type",
          "type": "string"
        },
        "key_claim_ids": {
          "items": {
            "maxLength": 70,
            "minLength": 70,
            "pattern": "^claim_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Key Claim Ids",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "business_decision_id",
        "key_claim_ids",
        "decision_text"
      ],
      "title": "BusinessDecisionRecord",
      "type": "object"
    },
    "EvaluationCase": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dataset_role": {
                "const": "holdout"
              }
            }
          },
          "then": {
            "properties": {
              "visibility": {
                "const": "private"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answerable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "key_claim_ids": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "description": "A product-facing query that only points to private label records by ID.",
      "properties": {
        "answerable": {
          "title": "Answerable",
          "type": "boolean"
        },
        "as_of_date": {
          "format": "date",
          "title": "As Of Date",
          "type": "string"
        },
        "business_decision_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Decision Id"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Case Id",
          "type": "string"
        },
        "dataset_role": {
          "enum": [
            "development",
            "holdout"
          ],
          "title": "Dataset Role",
          "type": "string"
        },
        "key_claim_ids": {
          "items": {
            "maxLength": 70,
            "minLength": 70,
            "pattern": "^claim_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Key Claim Ids",
          "type": "array",
          "uniqueItems": true
        },
        "label_version": {
          "const": "trade-intel-eval/v1",
          "default": "trade-intel-eval/v1",
          "title": "Label Version",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Question",
          "type": "string"
        },
        "reference_evidence_set_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Reference Evidence Set Id",
          "type": "string"
        },
        "task_type": {
          "$ref": "#/$defs/TaskType"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "question",
        "task_type",
        "answerable",
        "dataset_role",
        "visibility",
        "as_of_date",
        "reference_evidence_set_id",
        "key_claim_ids"
      ],
      "title": "EvaluationCase",
      "type": "object"
    },
    "EvaluationSnapshot": {
      "additionalProperties": false,
      "description": "The hashes that freeze a reproducible dataset and execution candidate.",
      "properties": {
        "code_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Hash",
          "type": "string"
        },
        "corpus_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Corpus Hash",
          "type": "string"
        },
        "dataset_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Hash",
          "type": "string"
        },
        "evaluator_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evaluator Hash",
          "type": "string"
        },
        "index_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Index Hash",
          "type": "string"
        },
        "model_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Hash",
          "type": "string"
        },
        "profile_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Hash",
          "type": "string"
        },
        "prompt_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Hash",
          "type": "string"
        },
        "reference_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Hash",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "dataset_hash",
        "reference_hash",
        "corpus_hash",
        "index_hash",
        "profile_hash",
        "model_hash",
        "prompt_hash",
        "evaluator_hash",
        "code_hash"
      ],
      "title": "EvaluationSnapshot",
      "type": "object"
    },
    "PerQueryResult": {
      "additionalProperties": false,
      "description": "A label-free trace retaining IDs and statuses needed to recompute metrics.",
      "properties": {
        "backend_statuses": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$": {
              "enum": [
                "available",
                "degraded",
                "unavailable",
                "not_run",
                "failed"
              ],
              "type": "string"
            }
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "title": "Backend Statuses",
          "type": "object"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Case Id",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "produced_claim_ids": {
          "items": {
            "maxLength": 70,
            "minLength": 70,
            "pattern": "^claim_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Produced Claim Ids",
          "type": "array",
          "uniqueItems": true
        },
        "retrieved_evidence_ids": {
          "items": {
            "maxLength": 68,
            "minLength": 68,
            "pattern": "^(?:rag|sql)_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Retrieved Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "refused",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "status",
        "retrieved_evidence_ids",
        "produced_claim_ids",
        "backend_statuses",
        "latency_ms"
      ],
      "title": "PerQueryResult",
      "type": "object"
    },
