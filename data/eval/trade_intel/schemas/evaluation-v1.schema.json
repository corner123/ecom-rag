    "RunManifest": {
      "additionalProperties": false,
      "description": "The reproducibility record for one evaluation run.\n\n``snapshot`` is the single source of every frozen input hash. Backend\nstatuses encode both available and degraded components without a second,\ncontradictory component list.",
      "properties": {
        "backend_statuses": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$": {
              "enum": [
                "available",
                "degraded",
                "unavailable",
                "not_run",
                "failed"
              ],
              "type": "string"
            }
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "title": "Backend Statuses",
          "type": "object"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/EvaluationSnapshot"
        }
      },
      "required": [
        "run_id",
        "snapshot",
        "backend_statuses"
      ],
      "title": "RunManifest",
      "type": "object"
    },
    "TaskType": {
      "description": "The task families represented in the controlled evaluation corpus.",
      "enum": [
        "exact_company_lookup",
        "hs_code_lookup",
        "semantic_lead_discovery",
        "operating_status",
        "product_competitor",
        "sql_aggregate",
        "mixed_source",
        "temporal_conflict",
        "duplicate_source",
        "insufficient_evidence",
        "unsafe_or_out_of_scope"
      ],
      "title": "TaskType",
      "type": "string"
    },
    "TemplateSignatureRecord": {
      "additionalProperties": false,
      "description": "A bundle-level leakage signature, independent of evidence availability.",
      "properties": {
        "artifact_type": {
          "const": "template_signature",
          "default": "template_signature",
          "title": "Artifact Type",
          "type": "string"
        },
        "template_family": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Template Family",
          "type": "string"
        }
      },
      "required": [
        "template_family"
      ],
      "title": "TemplateSignatureRecord",
      "type": "object"
    }
  },
  "$id": "https://trade-agent.local/schemas/evaluation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/EvaluationCase"
    },
    {
      "$ref": "#/$defs/ReferenceEvidence"
    },
    {
      "$ref": "#/$defs/ReferenceMatch"
    },
    {
      "$ref": "#/$defs/ReferenceClaim"
    },
    {
      "$ref": "#/$defs/BusinessDecision"
    },
    {
      "$ref": "#/$defs/ReferenceEvidenceRecord"
    },
    {
      "$ref": "#/$defs/ReferenceClaimRecord"
    },
    {
      "$ref": "#/$defs/BusinessDecisionRecord"
    },
    {
      "$ref": "#/$defs/ReferenceMatchRecord"
    },
    {
      "$ref": "#/$defs/TemplateSignatureRecord"
    },
    {
      "$ref": "#/$defs/EvaluationSnapshot"
    },
    {
      "$ref": "#/$defs/RunManifest"
    },
    {
      "$ref": "#/$defs/PerQueryResult"
    }
  ]
}
