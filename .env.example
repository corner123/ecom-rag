# Safe local-development examples only. Copy to .env and replace passwords locally.
ENVIRONMENT=development
MYSQL__HOST=127.0.0.1
MYSQL__PORT=3306
MYSQL__DATABASE=foreign_trade_db
MYSQL__ROOT_PASSWORD=replace-with-a-local-root-secret
MYSQL__MIGRATION_USER=trade_migrator
MYSQL__MIGRATION_PASSWORD=replace-with-a-local-migration-secret
MYSQL__QUERY_USER=trade_query
MYSQL__QUERY_PASSWORD=replace-with-a-local-query-secret
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-secret
MILVUS__HOST=127.0.0.1
MILVUS__PORT=19530
MILVUS__DATABASE=default
REDIS__HOST=127.0.0.1
REDIS__PORT=6379
REDIS__DATABASE=0
MODELS__EMBEDDING_MODEL=BAAI/bge-m3
MODELS__EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
MODELS__EMBEDDING_DEVICE=cpu
MODELS__EMBEDDING_BATCH_SIZE=16
# Optional host cache directory; Compose supplies its own named cache volume.
MODELS__EMBEDDING_CACHE_DIR=
MODELS__EMBEDDING_OFFLINE=false
MODELS__RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODELS__RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
MODELS__GENERATION_PROVIDER=deterministic
LIMITS__MAX_GRAPH_STEPS=12
LIMITS__MAX_RETRIES=1
LIMITS__MAX_LLM_CALLS=5
