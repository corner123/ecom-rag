# DeepSeek API. /retrieve, routing, evidence guards and evaluation never call
# the model. /answer may send the question and selected evidence excerpts to
# this external API when the provider is auto/deepseek.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Safe default: explicitly switch to deepseek only after approving external
# transmission of the question and selected evidence excerpts.
ENGINEERING_GENERATION_PROVIDER=deterministic
ENGINEERING_LLM_TIMEOUT_SECONDS=60
ENGINEERING_LLM_MAX_RETRIES=1
ENGINEERING_LLM_MAX_TOKENS=1800
ENGINEERING_LLM_TEMPERATURE=0.1
ENGINEERING_LLM_THINKING_ENABLED=false

# Engineering dense-vector backend. Every new engineering build keeps a local
# FAISS copy. Use --backend both (or milvus) during engineering-build before
# choosing milvus/auto at query time; auto only falls back on availability
# failures, while authentication/schema errors fail closed.
ENGINEERING_INDEX_BUILD_BACKEND=faiss
ENGINEERING_VECTOR_BACKEND=faiss
ENGINEERING_MILVUS_URI=http://127.0.0.1:19530
ENGINEERING_MILVUS_TOKEN=
ENGINEERING_MILVUS_DATABASE=default
# Required for Milvus builds: choose a stable, deployment-unique identifier.
ENGINEERING_MILVUS_NAMESPACE=replace-with-unique-deployment-name
ENGINEERING_MILVUS_COLLECTION_PREFIX=engineering_rag
ENGINEERING_MILVUS_TIMEOUT_SECONDS=10

# Optional PDF structural parser. If the executable is unavailable or returns
# a recoverable conversion failure, the source router uses PyMuPDF and records
# parse_degraded=true plus parse_warnings in the canonical DocumentRecord.
MINERU_EXECUTABLE=mineru

# Opt-in real-Milvus tests deliberately use separate MILVUS_TEST_* variables;
# do not point them at production collections. Leave unset for normal tests.
# MILVUS_TEST_URI=http://127.0.0.1:19530
# MILVUS_TEST_TOKEN=
# MILVUS_TEST_DATABASE=default

# Legacy demo Milvus connection (used only by main.py build/query/stats).
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# Legacy demo embedding models
EMBEDDING_MODEL_PATH=BAAI/bge-large-zh-v1.5
SPARSE_EMBEDDING_MODEL_PATH=BAAI/bge-m3
MULTIMODAL_MODEL_PATH=BAAI/visualized-base

# Engineering RAG embedding and optional reranker
ENGINEERING_EMBEDDING_MODEL_PATH=BAAI/bge-small-zh-v1.5
RERANKER_MODEL_PATH=BAAI/bge-reranker-base
ENGINEERING_RERANK_ENABLED=false

# Data paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EVAL_DATA_DIR=data/eval
ENGINEERING_INDEX_DIR=data/indexes/ecommerce_demo
ENGINEERING_MANIFEST_PATH=data/manifests/builds/ecommerce_demo.json
SOURCE_CATALOG_PATH=data/sources/ecommerce_demo.yaml

# Independent Git repository used as the read-only source and verification target.
# The generic names are preferred; MINI_NANOBOT_REPO remains a compatibility alias.
KNOWLEDGE_TARGET_REPO=../ecommerce-engineering-demo
ENGINEERING_TARGET_SOURCE_ID=ecommerce_demo
MINI_NANOBOT_REPO=../Mini-Nanobot

# Read-only RAG HTTP integration.
# RAG_API_TOKEN configures this RAG server. Copy BASE_URL, the same TOKEN, and
# TIMEOUT belong to an optional independent read-only client; BASE_URL and
# TIMEOUT are not consumed by the RAG server itself.
RAG_API_BASE_URL=http://127.0.0.1:8000
RAG_API_TOKEN=
RAG_API_TIMEOUT_SECONDS=15
RAG_UI_PORT=8000

# Logging
LOG_LEVEL=INFO
